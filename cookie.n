@cmd (.) : ls -al

@cmd (.) : git status

@cmd (.) : git add .

@cmd (.) : git commit -m "2025.00 mac"

@cmd (.) : git push

---

@cmd (./public) : ls
@cmd (./public) : mv Noterm2025-mac.tar.gz ./releases/


@cmd (./public/releases) : ls
@cmd (./public/releases) : open Noterm.app


"comprimi"
@cmd (./public) : tar -czvf Noterm${version}-mac.tar.gz -C releases .

"visualizza contenuto"
@cmd (./public/releases) : tar -tzvf Noterm${version}-mac.tar.gz

"decomprimi"
tar -xvzf Noterm.tar.gz -C /percorso/della/destinazione
